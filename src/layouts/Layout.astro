---
// Layout global: tipografía, tokens y metadatos base.
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Wood Carpentry — Bespoke furniture & joinery in Madrid</title>
    <meta
      name="description"
      content="Bespoke kitchens, wardrobes and furniture, designed with you and handcrafted in our Madrid workshop. Solid wood, honest joinery and a finish made to last."
    />
    <meta name="theme-color" content="#F4EFE7" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Wood Carpentry — Bespoke furniture & joinery" />
    <meta
      property="og:description"
      content="Bespoke kitchens, wardrobes and furniture, designed with you and handcrafted in Madrid."
    />
    <meta property="og:locale" content="en_GB" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23A9502F'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='18' fill='%23F4EFE7' text-anchor='middle'%3EW%3C/text%3E%3C/svg%3E"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter+Tight:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Activa los estilos de reveal solo si hay JS; sin JS el contenido queda visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
